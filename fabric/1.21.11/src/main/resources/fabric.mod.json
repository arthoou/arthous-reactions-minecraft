{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.arthou.arthousreactions.fabric.ArthousReactionsFabricMod"
    ],
    "client": [
      "com.arthou.arthousreactions.fabric.ArthousReactionsFabricClient"
    ]
  },
  "mixins": [
    "arthousreactions.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}"
  }
}
